<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expense Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-rose-50/30 min-h-screen">
    <nav class="bg-white border-b border-rose-100 shadow-sm sticky top-0 z-40">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-rose-600 rounded-lg shadow-lg shadow-rose-200 flex items-center justify-center transform -rotate-3 hover:rotate-0 transition-transform">
                        <i class="fas fa-piggy-bank text-white text-base"></i>
                    </div>
                    <span class="text-base font-black bg-gradient-to-r from-rose-600 to-red-500 bg-clip-text text-transparent tracking-tighter">ExpenseTracker</span>
                </div>

                <% if (locals.user) { %>
                <div class="hidden md:flex items-center space-x-1">
                    <a href="/" class="px-3 py-1.5 text-[11px] font-black uppercase tracking-widest <%= locals.page === 'dashboard' ? 'text-rose-600 bg-rose-50' : 'text-slate-500 hover:text-rose-600 hover:bg-rose-50/50' %> rounded-lg transition-all">
                        Overview
                    </a>
                    <a href="/history" class="px-3 py-1.5 text-[11px] font-black uppercase tracking-widest <%= locals.page === 'history' ? 'text-rose-600 bg-rose-50' : 'text-slate-500 hover:text-rose-600 hover:bg-rose-50/50' %> rounded-lg transition-all">
                        History
                    </a>
                </div>
                <% } %>

                <div class="flex items-center space-x-4">
                    <% if (locals.user) { %>
                        <div class="hidden lg:flex items-center text-rose-900/30 font-black text-[9px] uppercase tracking-widest">
                            <span class="text-rose-600 mr-1"><%= user.username %></span>
                        </div>
                        <a href="/logout" class="group flex items-center gap-2 text-[9px] font-black uppercase tracking-widest text-rose-700 hover:text-white border border-rose-100 hover:bg-rose-600 hover:border-rose-600 px-3 py-1.5 rounded-lg transition-all">
                            <i class="fas fa-power-off"></i>
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <% if (locals.user) { %>
    <!-- Mobile Navigation -->
    <div class="md:hidden fixed bottom-6 left-6 right-6 z-50 bg-white/90 backdrop-blur-xl border border-slate-100 rounded-xl shadow-2xl flex items-center justify-around p-2">
        <a href="/" class="flex flex-col items-center gap-1 px-4 py-1.5 <%= locals.page === 'dashboard' ? 'text-rose-600' : 'text-slate-400' %>">
            <i class="fas fa-home-alt text-base"></i>
            <span class="text-[7px] font-black uppercase tracking-widest">Overview</span>
        </a>
        <a href="/history" class="flex flex-col items-center gap-1 px-4 py-1.5 <%= locals.page === 'history' ? 'text-rose-600' : 'text-slate-400' %>">
            <i class="fas fa-history text-base"></i>
            <span class="text-[7px] font-black uppercase tracking-widest">History</span>
        </a>
    </div>
    <% } %>
    <main class="max-w-5xl mx-auto py-6 md:py-10 px-4 sm:px-6 lg:px-8">
